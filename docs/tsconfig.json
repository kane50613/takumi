{
  "include": ["**/*", "**/.server/**/*", "**/.client/**/*", ".source/**/*"],
  // Registry sources ship to other projects, where the CLI rewrites their
  // imports to that project's alias. They never resolve here.
  "exclude": ["app/registry/image/og-route.tsx"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["node", "vite/client", "bun"],
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "~/*": ["./app/*"]
    },
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  }
}
