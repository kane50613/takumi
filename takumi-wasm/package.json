{
  "name": "@takumi-rs/wasm",
  "version": "0.65.0",
  "keywords": [
    "image",
    "rendering",
    "css",
    "react",
    "jsx",
    "webassembly"
  ],
  "scripts": {
    "build": "bun run build:web && bun run build:node",
    "build:debug": "bun run build:web:debug && bun run build:node:debug",
    "build:web": "wasm-pack build --no-pack --release --out-dir pkg --target web",
    "build:node": "wasm-pack build --no-pack --release --out-dir pkg-node --target nodejs",
    "build:web:debug": "wasm-pack build --no-pack --dev --out-dir pkg --target web",
    "build:node:debug": "wasm-pack build --no-pack --dev --out-dir pkg --target nodejs"
  },
  "author": {
    "email": "me@kane.tw",
    "name": "Kane Wang",
    "url": "https://kane.tw"
  },
  "repository": {
    "url": "git+https://github.com/kane50613/takumi.git"
  },
  "readme": "README.md",
  "license": "(MIT OR Apache-2.0)",
  "devDependencies": {
    "@takumi-rs/helpers": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./pkg/takumi_wasm.d.ts",
      "default": "./pkg/takumi_wasm.js"
    },
    "./takumi_wasm_bg.wasm": {
      "types": "./pkg/takumi_wasm_bg.wasm.d.ts",
      "default": "./pkg/takumi_wasm_bg.wasm"
    },
    "./next": {
      "types": "./bundlers/next.d.ts",
      "default": "./bundlers/next.js"
    },
    "./node": {
      "types": "./pkg-node/takumi_wasm.d.ts",
      "default": "./pkg-node/takumi_wasm.js"
    }
  },
  "files": [
    "README.md",
    "pkg/takumi*",
    "pkg-node/takumi*",
    "bundlers/*"
  ]
}
