{
  "name": "takumi-js",
  "version": "0.0.0",
  "description": "All-in-one Takumi package for Node.js and WebAssembly runtimes.",
  "license": "(MIT OR Apache-2.0)",
  "author": {
    "name": "Kane Wang",
    "email": "me@kane.tw",
    "url": "https://kane.tw"
  },
  "repository": {
    "url": "git+https://github.com/kane50613/takumi.git"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "response",
    "node",
    "wasm",
    "helpers",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./response": {
      "types": "./dist/response/index.d.ts",
      "default": "./dist/response/index.js"
    },
    "./node": {
      "types": "./src/node/index.d.ts",
      "default": "./src/node/index.js"
    },
    "./wasm": {
      "types": "./src/wasm/index.d.ts",
      "default": "./src/wasm/index.js"
    },
    "./helpers": {
      "types": "./src/helpers/index.d.ts",
      "default": "./src/helpers/index.mjs"
    },
    "./helpers/*": {
      "types": "./src/helpers/*/index.d.ts",
      "default": "./src/helpers/*/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublishOnly": "jq '.dependencies[\"@takumi-rs/core\"] = .version | .dependencies[\"@takumi-rs/helpers\"] = .version | .dependencies[\"@takumi-rs/wasm\"] = .version' package.json > tmp.json && mv tmp.json package.json",
    "build": "tsup src/index.ts src/response/index.ts --format esm --dts --out-dir dist"
  },
  "dependencies": {
    "@takumi-rs/core": "workspace:*",
    "@takumi-rs/helpers": "workspace:*",
    "@takumi-rs/wasm": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "react": "^19.2.4",
    "tsup": "^8.5.1"
  }
}
