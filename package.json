{
  "name": "takumi",
  "private": true,
  "workspaces": [
    "takumi-js",
    "takumi-helpers",
    "takumi-napi",
    "takumi-wasm",
    "takumi-image-response",
    "takumi-pdf-js",
    "docs",
    "example/*"
  ],
  "scripts": {
    "test": "bun --filter '*' test --silent",
    "build": "bun --filter '*' run build",
    "lint": "oxlint --format=github && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "tegami": "bun scripts/tegami.mts",
    "knip": "knip-bun --no-config-hints",
    "postinstall": "lefthook install",
    "publish-lint": "bun --filter '*' publish-lint"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/bun": "^1.3.14",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "publint": "^0.3.23",
    "tegami": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@takumi-rs/image-response": "workspace:*",
    "rolldown-plugin-dts": "0.27.6",
    "takumi-js": "workspace:*",
    "vite": "8.2.1"
  },
  "catalog": {
    "@types/bun": "^1.3.14",
    "csstype": "^3.2.3",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.4",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "0.22.14",
    "unrun": "^0.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "trustedDependencies": [
    "webgpu"
  ]
}
