{
  "name": "takumi-workspace",
  "private": true,
  "workspaces": [
    "takumi-js",
    "takumi-helpers",
    "takumi-bindings-js",
    "takumi-napi",
    "takumi-wasm",
    "takumi-image-response",
    "takumi-pdf-js",
    "takumi-paint",
    "docs",
    "example/*"
  ],
  "scripts": {
    "test": "bun --filter '*' test --silent",
    "build": "bun --filter '*' run build",
    "fmt": "cargo fmt --all && oxfmt --write",
    "lint": "oxlint --format=github && oxfmt --check && bun scripts/check-skills.mts",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "tegami": "bun scripts/tegami.mts",
    "knip": "knip-bun --no-config-hints",
    "postinstall": "lefthook install",
    "publish-lint": "bun --filter '*' publish-lint",
    "typecheck": "bun --filter '@takumi-rs/*' --filter 'takumi-*' typecheck"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/bun": "^1.4.4",
    "knip": "^6.45.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "publint": "^0.3.25",
    "tegami": "^1.5.0",
    "typescript": "catalog:"
  },
  "overrides": {
    "@takumi-rs/image-response": "workspace:*",
    "rolldown-plugin-dts": "0.30.2",
    "takumi-js": "workspace:*",
    "vite": "8.3.8",
    "waku": "1.0.0-rc.4"
  },
  "catalog": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "csstype": "^3.2.3",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.5",
    "tsdown": "0.23.7",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1",
    "vite": "^8.3.8"
  },
  "trustedDependencies": [
    "webgpu"
  ]
}
