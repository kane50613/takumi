{
  "name": "takumi",
  "private": true,
  "workspaces": [
    "takumi",
    "takumi-js",
    "takumi-helpers",
    "takumi-napi-core",
    "takumi-wasm",
    "takumi-image-response",
    "takumi-template",
    "docs",
    "example/*"
  ],
  "scripts": {
    "lint": "oxlint --format=github && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "version": "changeset version && bun --filter '*' version",
    "release": "changeset publish && bun --filter '*' release",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "takumi-js": "workspace:*",
    "typescript": "catalog:"
  },
  "catalog": {
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.2.3",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsdown": "^0.22.0",
    "unrun": "^0.3.0",
    "typescript": "6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.5"
  }
}
