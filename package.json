{
  "name": "takumi",
  "private": true,
  "workspaces": [
    "takumi-css",
    "takumi",
    "takumi-js",
    "takumi-helpers",
    "takumi-napi-core",
    "takumi-wasm",
    "takumi-image-response",
    "takumi-template",
    "docs",
    "example/*"
  ],
  "scripts": {
    "lint": "oxlint --format=github && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "version": "changeset version && bun --filter '*' version",
    "release": "changeset publish && bun --filter '*' release",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.3",
    "@changesets/cli": "^2.31.0",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "publint": "^0.3.21",
    "takumi-js": "workspace:*",
    "typescript": "catalog:"
  },
  "catalog": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19.2.3",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsdown": "^0.22.3",
    "unrun": "^0.3.1",
    "typescript": "6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
