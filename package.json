{
  "name": "takumi",
  "private": true,
  "workspaces": [
    "takumi-js",
    "takumi-helpers",
    "takumi-napi",
    "takumi-wasm",
    "takumi-image-response",
    "takumi-template",
    "docs",
    "example/*"
  ],
  "scripts": {
    "lint": "oxlint --format=github && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "tegami": "bun scripts/tegami.mts",
    "postinstall": "lefthook install",
    "publish-lint": "bun --filter '*' publish-lint"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.3",
    "@arethetypeswrong/core": "^0.18.3",
    "@types/node": "catalog:",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "publint": "^0.3.21",
    "takumi-js": "workspace:*",
    "tegami": "0.1.0-beta.4",
    "typescript": "catalog:"
  },
  "catalog": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19.2.3",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsdown": "^0.22.3",
    "unrun": "^0.3.1",
    "typescript": "6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
