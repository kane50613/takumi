{
  "name": "takumi",
  "private": true,
  "workspaces": [
    "takumi-js",
    "takumi-helpers",
    "takumi-napi",
    "takumi-wasm",
    "takumi-image-response",
    "takumi-template",
    "docs",
    "example/*"
  ],
  "scripts": {
    "test": "bun --filter '*' test --silent",
    "build": "bun --filter '*' run build",
    "lint": "oxlint --format=github && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "tegami": "bun scripts/tegami.mts",
    "knip": "knip-bun --no-config-hints",
    "postinstall": "lefthook install",
    "publish-lint": "bun --filter '*' publish-lint"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/bun": "catalog:",
    "knip": "^6.27.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "publint": "^0.3.21",
    "tegami": "^1.2.5",
    "typescript": "catalog:"
  },
  "overrides": {
    "@takumi-rs/image-response": "workspace:*",
    "rolldown-plugin-dts": "0.27.6",
    "takumi-js": "workspace:*",
    "vite": "8.1.5"
  },
  "catalog": {
    "@types/bun": "^1.3.14",
    "csstype": "^3.2.3",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19.2.3",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsdown": "0.22.5",
    "unrun": "^0.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  },
  "trustedDependencies": [
    "webgpu"
  ]
}
