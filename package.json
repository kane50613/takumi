{
  "name": "takumi",
  "private": true,
  "workspaces": [
    "takumi",
    "takumi-js",
    "takumi-helpers",
    "takumi-napi-core",
    "takumi-wasm",
    "takumi-image-response",
    "takumi-template",
    "docs",
    "example/*"
  ],
  "scripts": {
    "lint": "oxlint --format=github && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "version": "changeset version && bun --filter '*' version",
    "release": "changeset publish && bun --filter '*' release",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "takumi-js": "workspace:*",
    "typescript": "catalog:"
  },
  "catalog": {
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.2.3",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsdown": "^0.21.9",
    "typescript": "6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
