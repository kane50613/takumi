{
  "name": "takumi",
  "private": true,
  "workspaces": [
    "takumi",
    "takumi-js",
    "takumi-helpers",
    "takumi-napi-core",
    "takumi-wasm",
    "takumi-image-response",
    "takumi-template",
    "docs",
    "example/*"
  ],
  "scripts": {
    "lint": "oxlint --format=github && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "version": "changeset version && bun --filter '*' version",
    "release": "changeset publish && bun --filter '*' release",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "lefthook": "^2.1.4",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "takumi-js": "workspace:*",
    "typescript": "catalog:"
  },
  "catalog": {
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.2.3",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsdown": "^0.21.6",
    "typescript": "5.9.3",
    "vite": "^8.0.2"
  }
}
