{
  "name": "@takumi-rs/helpers",
  "version": "1.1.1",
  "description": "Utility helpers for converting JSX/HTML to Takumi node trees and handling resources.",
  "keywords": [
    "css",
    "emoji",
    "html",
    "image",
    "jsx",
    "react",
    "rendering"
  ],
  "homepage": "https://takumi.kane.tw/docs/architecture#fromjsx-helper",
  "bugs": {
    "url": "https://github.com/kane50613/takumi/issues"
  },
  "license": "(MIT OR Apache-2.0)",
  "author": {
    "name": "Kane Wang",
    "email": "me@kane.tw",
    "url": "https://kane.tw"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kane50613/takumi.git",
    "directory": "takumi-helpers"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./html": {
      "types": "./dist/html.d.mts",
      "import": "./dist/html.mjs",
      "require": "./dist/html.cjs",
      "default": "./dist/html.mjs"
    },
    "./jsx": {
      "types": "./dist/jsx.d.mts",
      "import": "./dist/jsx.mjs",
      "require": "./dist/jsx.cjs",
      "default": "./dist/jsx.mjs"
    },
    "./emoji": {
      "types": "./dist/emoji.d.mts",
      "import": "./dist/emoji.mjs",
      "require": "./dist/emoji.cjs",
      "default": "./dist/emoji.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "ultrahtml": "^1.6.0"
  },
  "peerDependencies": {
    "react": "^19.2.5",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
